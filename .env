# ---------- YOU HAVE TO CHANGE ALL OF THEM (except perhaps the PUID/PGID) ----------

# ---------- General ----------
PUID=1000
PGID=1000
TZ=Europe/Athens

# ---------- Media / data paths ----------
FB_ROOT=/mnt/storage
TV_PATH=/mnt/storage/media/tvshows
ANIME_PATH=/mnt/storage/media/anime
MOVIES_PATH=/mnt/storage/media/movies
MUSIC_PATH=/mnt/storage/media/music
BOOKS_PATH=/mnt/storage/media/audiobooks
PHOTOS_PATH=/mnt/storage/photos

# ---------- Filebrowser Quantum ----------
FB_USER=admin
FB_PASS='ChangeMe-FB-123'

# ---------- Miniflux ----------
# Keep MF_DB_PASS alphanumeric: it is embedded in a URL
MF_DB_USER=miniflux
MF_DB_PASS=ChangeMeMinifluxDb123
MF_DB_NAME=miniflux
MF_ADMIN_USER=admin
MF_ADMIN_PASS='ChangeMe-MF-123'

# ---------- PinePods ----------
PP_HOST=http://192.168.1.50:8040
PP_DB_USER=postgres
PP_DB_PASS=ChangeMePinepodsDb123
PP_DB_NAME=pinepods_database
PP_USER=admin
PP_PASS='ChangeMe-PP-123'
PP_NAME=Admin User
PP_EMAIL=admin@example.com

# ---------- Owncast ----------
OC_KEY=ChangeMeStreamKey123
